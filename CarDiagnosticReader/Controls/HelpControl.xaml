<UserControl x:Class="CarDiagnosticReader.Controls.HelpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarDiagnosticReader.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Margin="10">

            <TextBlock Text="Tutorial" FontWeight="Bold" FontSize="24"/>

            <TextBlock Text="Step 1(optional): Open the definition file" FontWeight="Bold" Margin="0,20,0,0"/>
            <TextBlock TextWrapping="Wrap" Text="Click the 'Open' button on the 'File Explorer' tab. In the file dialog that appears, select the definition file that contains your car data. Click 'OK' to load the data into the application." Margin="0,10"/>

            <TextBlock Text="Step 2: Load the binary file" FontWeight="Bold" Margin="0,20,0,0"/>
            <TextBlock TextWrapping="Wrap" Text="Next, click the 'Binary File' button on the 'File Explorer' tab. In the file dialog that appears, select the binary file that corresponds to your definition data. Click 'OK' to load the binary data." Margin="0,10"/>

            <TextBlock Text="Step 3: Viewing the Heatmap" FontWeight="Bold" Margin="0,20,0,0"/>
            <TextBlock TextWrapping="Wrap" Text="After you've loaded your data, click the 'View' tab. Here you'll see a heatmap representing the car data you've loaded. You can customize how the heatmap is displayed using the controls in this tab." Margin="0,10"/>

            <!-- Add more steps as needed... -->

            <TextBlock Text="Frequently Asked Questions" FontWeight="Bold" FontSize="24" Margin="0,20,0,0"/>
            <TextBlock TextWrapping="Wrap" Text="A list of Frequently Asked Questions about the application" Margin="0,10"/>

            <TextBlock Text="Troubleshooting Guide" FontWeight="Bold" FontSize="24" Margin="0,20,0,0"/>
            <TextBlock TextWrapping="Wrap" Text="Some common issues that users might encounter and steps to resolve them." Margin="0,10"/>

            <TextBlock Text="Contact Information" FontWeight="Bold" FontSize="24" Margin="0,20,0,0"/>
            <TextBlock TextWrapping="Wrap" Text="Information on how the user can reach out for additional help such as email address." Margin="0,10"/>

        </StackPanel>

    </ScrollViewer>
</UserControl>
