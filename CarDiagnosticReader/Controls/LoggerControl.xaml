<UserControl x:Class="CarDiagnosticReader.Controls.LoggerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarDiagnosticReader.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="800"
             Background="black"
             >
   


    <Grid>
        <ListBox x:Name="logListBox" ItemsSource="{Binding LogMessages}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="White" FontSize="10" FontFamily="Comic Sans MS, Verdana"  HorizontalAlignment="Right" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
